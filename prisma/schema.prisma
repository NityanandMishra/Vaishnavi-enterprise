// ─────────────────────────────────────────────────────────────────────────────
// Vaishnavi Enterprises — Prisma Schema v2.4 (SQLite Dev / PostgreSQL Production)
// Local dev  : SQLite (DATABASE_URL="file:./dev.db")
// Production : Switch provider to "postgresql" + update DATABASE_URL
//
// POSTGRESQL MIGRATION NOTES (when deploying):
//   - Change provider = "sqlite" → "postgresql"
//   - Change specs String → Json
//   - Change shippingAddress String → Json
//   - (Optional) Convert the String representation of roles, modes, and statuses
//     to native PostgreSQL Enums if desired.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── NEXTAUTH REQUIRED MODELS ────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USER ────────────────────────────────────────────────────────────────────
// Role values: "CUSTOMER" | "ADMIN"

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  emailVerified DateTime? // Required by NextAuth standard Adapter
  image         String?   // Required by NextAuth standard Adapter
  phone         String?   @unique
  passwordHash  String?
  role          String    @default("CUSTOMER") // "CUSTOMER" | "ADMIN" | "SUPER_ADMIN" | "CATALOG_MANAGER" | "OPS_EXECUTIVE" | "FINANCE"
  name          String?
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  addresses     Address[]
  orders        Order[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  accounts      Account[]
  sessions      Session[]
  carts         Cart[]
}

// ─── ADDRESS ─────────────────────────────────────────────────────────────────

model Address {
  id             String  @id @default(uuid())
  userId         String
  fullName       String
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  state          String
  pincode        String
  alternatePhone String?
  isDefault      Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── MEDIA IMAGE (Shared Library) ────────────────────────────────────────────

model MediaImage {
  id        String   @id @default(uuid())
  url       String   // Supabase Storage public URL
  filename  String   // Original filename before compression
  size      Int      // File size in bytes after compression
  width     Int?     // Pixel width after compression
  height    Int?     // Pixel height after compression
  alt       String?  // Alt text for accessibility and SEO
  createdAt DateTime @default(now())

  products   ProductImage[]
  brands     Brand[]        // Brands that use this image as their logo
  categories Category[]     // Categories that use this as banner image
}

// ─── BRAND ───────────────────────────────────────────────────────────────────

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoId      String?   // References MediaImage
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  logo     MediaImage? @relation(fields: [logoId], references: [id])
  products Product[]
}

// ─── CATEGORY ────────────────────────────────────────────────────────────────
// defaultCheckoutMode values: "BUY" | "INQUIRE"

model Category {
  id                  String    @id @default(uuid())
  name                String
  slug                String    @unique
  description         String?
  imageId             String?   // References MediaImage for category banner
  defaultCheckoutMode String    @default("BUY") // "BUY" | "INQUIRE"
  hsnCode             String?   // Default HSN code for products in this category
  gstRate             Float?    @default(18.0) // Default GST % (e.g. 18.0)
  sortOrder           Int       @default(0)
  parentId            String?   // null = top-level; populated = sub-category
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  image              MediaImage?         @relation(fields: [imageId], references: [id])
  parent             Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryHierarchy")
  products           Product[]
  categoryAttributes CategoryAttribute[]
  hsnMapping         CategoryHsnMapping?

  // No two categories may share the same name within the same parent scope
  @@unique([name, parentId])
}

// ─── PRODUCT ─────────────────────────────────────────────────────────────────
// checkoutMode values: "BUY" | "INQUIRE"
// stockMode values: "TRACKED" | "VIRTUAL" | "INQUIRE"

model Product {
  id               String    @id @default(uuid())
  title            String
  slug             String?   @unique
  description      String
  shortDescription String?
  basePrice        Float
  checkoutMode     String    // "BUY" | "INQUIRE"
  stockMode        String    // "TRACKED" | "VIRTUAL" | "INQUIRE"
  status           String    @default("DRAFT") // "DRAFT" | "ACTIVE" | "INACTIVE" | "ARCHIVED"
  isAvailable      Boolean   @default(true)
  categoryId       String
  brandId          String?
  unit             String?   @default("Piece")
  unitId           String?
  sellerId         String?   // House seller record default, future multi-vendor (D-02)
  hsnCode          String?   // Overrides Category HSN code (D-06)
  hsnId            String?
  gstRate          Float?    // Overrides Category GST % (D-06)
  specs            String    @default("{}") // SQLite: stored as JSON string
  metaTitle        String?
  metaDescription  String?
  publishedAt      DateTime?
  archivedAt       DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  category        Category                @relation(fields: [categoryId], references: [id])
  brand           Brand?                  @relation(fields: [brandId], references: [id])
  unitRel         Unit?                   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  hsnRel          HsnCode?                @relation(fields: [hsnId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  drafts          ProductDraft[]
  wishlist        WishlistItem[]
  reviews         Review[]
  leads           Lead[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
}

// ─── PRODUCT IMAGE (Join Table) ───────────────────────────────────────────────

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  imageId   String
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)
  altText   String? // Per-product image alt text override

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   MediaImage @relation(fields: [imageId], references: [id])

  @@unique([productId, imageId])
}

// ─── PRODUCT VARIANT ─────────────────────────────────────────────────────────

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String
  title       String    // e.g. "1200mm Brown", "2.5mm Black 90M", "50W Cool White"
  price       Float?    // null = inherits product basePrice
  mrp         Float?    // Maximum Retail Price
  stock       Int       @default(0) // Active only when Product.stockMode = "TRACKED"
  sku         String?   @unique
  color       String?
  size        String?
  weightGrams Float?
  lengthMm    Float?
  widthMm     Float?
  heightMm    Float?
  isDefault   Boolean   @default(false)
  position    Int       @default(0)
  isAvailable Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  inventories     Inventory[]
  movements       InventoryMovement[]
  stockAlerts     StockAlert[]
}

// ─── PRODUCT DRAFT (Autosave Storage) ────────────────────────────────────────

model ProductDraft {
  id        String   @id @default(uuid())
  productId String?
  userId    String?
  payload   String   // JSON string snapshot of in-progress form
  updatedAt DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

// ─── PRODUCT IMPORT BATCH (CSV Rollback) ─────────────────────────────────────

model ProductImportBatch {
  id           String    @id @default(uuid())
  userId       String?
  filename     String
  totalRows    Int
  createdCount Int
  updatedCount Int
  skippedCount Int
  status       String    @default("COMPLETED") // "COMPLETED" | "REVERTED" | "FAILED"
  snapshot     String?   // JSON snapshot for 24h rollback
  createdAt    DateTime  @default(now())
  revertedAt   DateTime?
}

// ─── SAVED PRODUCT VIEW (Filter Preset) ──────────────────────────────────────

model SavedProductView {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  filters   String   // JSON string of saved filters, sorts, columns
  createdAt DateTime @default(now())
}

// ─── ATTRIBUTES & VARIANTS (EPIC-01: ATTR) ──────────────────────────────────
// inputType values: "SINGLE_SELECT" | "MULTI_SELECT" | "TEXT" | "NUMBER" | "BOOLEAN"

model Attribute {
  id                String    @id @default(uuid())
  name              String
  code              String    @unique // Lowercase slug, immutable after creation
  inputType         String    @default("SINGLE_SELECT") // "SINGLE_SELECT" | "MULTI_SELECT" | "TEXT" | "NUMBER" | "BOOLEAN"
  isVariantDefining Boolean   @default(false) // true only for SINGLE_SELECT attributes that generate SKUs
  description       String?
  usesSwatches      Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  values             AttributeValue[]
  categoryAttributes CategoryAttribute[]
  productValues      ProductAttributeValue[]
  variantValues      VariantAttributeValue[]
}

model AttributeValue {
  id             String    @id @default(uuid())
  attributeId    String
  label          String
  code           String    // Lowercase slug, immutable after creation
  swatchHex      String?   // e.g. "#006A4E"
  swatchImageUrl String?   // URL for texture swatches
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  attribute              Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributeValues ProductAttributeValue[]
  variantAttributeValues VariantAttributeValue[]

  @@unique([attributeId, code])
}

model CategoryAttribute {
  id           String   @id @default(uuid())
  categoryId   String
  attributeId  String
  isRequired   Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
}

model ProductAttributeValue {
  id               String   @id @default(uuid())
  productId        String
  attributeId      String
  attributeValueId String?  // Set for SELECT / MULTI_SELECT
  textValue        String?  // Set for TEXT
  numberValue      Float?   // Set for NUMBER
  boolValue        Boolean? // Set for BOOLEAN
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id])
}

model VariantAttributeValue {
  id               String @id @default(uuid())
  variantId        String
  attributeId      String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([variantId, attributeId])
}

// ─── CART (Required for Server-Side Cart Persistence) ────────────────────────

model Cart {
  id        String     @id @default(uuid())
  userId    String?    // Nullable for guest carts
  token     String     @unique // Unique token passed in cookies for guest verification
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?  // Optional relation to specific product variant
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─── ORDER (EPIC-05: ORD) ───────────────────────────────────────────────────
// source values: "WEB" | "MANUAL" | "PHONE"
// status values: "PENDING" | "CONFIRMED" | "PROCESSING" | "PACKED" | "SHIPPED" | "DELIVERED" | "CANCELLED" | "RETURNED"
// paymentStatus values: "PENDING" | "PARTIALLY_PAID" | "PAID" | "REFUND_DUE" | "REFUNDED" | "FAILED"
// paymentMethod values: "COD" | "UPI" | "CARD" | "NETBANKING" | "WALLET" | "BANK_TRANSFER" | "CASH" | "RAZORPAY"

model Order {
  id                String    @id @default(uuid())
  orderNumber       String?   @unique // Human-facing e.g. "VE-2026-0891"
  userId            String?   // Nullable for guest/manual orders
  source            String    @default("WEB") // "WEB" | "MANUAL" | "PHONE"
  status            String    @default("PENDING")
  paymentStatus     String    @default("PENDING") // "PENDING" | "PARTIALLY_PAID" | "PAID" | "REFUND_DUE" | "REFUNDED" | "FAILED"
  paymentMethod     String    // "COD" | "UPI" | "CARD" | "NETBANKING" | "WALLET" | "BANK_TRANSFER" | "CASH" | "RAZORPAY"

  // Stored financial snapshots, never recomputed on read (FI-03)
  subtotalAmount    Float     @default(0)
  discountAmount    Float     @default(0)
  shippingCost      Float     @default(0)
  taxableAmount     Float     @default(0)
  cgstAmount        Float     @default(0)
  sgstAmount        Float     @default(0)
  igstAmount        Float     @default(0)
  cessAmount        Float     @default(0)
  taxAmount         Float     @default(0)
  totalAmount       Float
  paidAmount        Float     @default(0)
  balanceAmount     Float     @default(0)
  refundDueAmount   Float     @default(0)

  // Snapshot addresses (JSON strings) & delivery location
  shippingAddress   String    // SQLite: JSON string snapshot of address
  billingAddress    String?   // SQLite: JSON string snapshot of billing address
  deliveryStateCode String?   // e.g. "27", "29", "09"
  deliveryZone      String?   // "LOCAL" | "UP" | "PAN_INDIA" | "REST_OF_INDIA" | "MUMBAI_METRO"

  // Denormalised customer snapshot for fast multi-field search & manual/guest orders
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  customerNote      String?

  // External references
  couponCode        String?
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  shiprocketOrderId String?   @unique
  trackingNumber    String?
  trackingUrl       String?
  sellerId          String?   // House seller record default (D-02)

  // Status timestamps & SLA (ORD-10)
  placedAt          DateTime  @default(now())
  confirmedAt       DateTime?
  processingAt      DateTime?
  packedAt          DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?
  cancellationNote   String?
  slaDueAt          DateTime? // Configurable SLA in hours (ORD-10)
  createdBy         String?   // Staff name/id for manual orders
  version           Int       @default(1)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user          User?                @relation(fields: [userId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  notes         OrderNote[]
  invoice       Invoice?

  @@index([status, placedAt])
  @@index([slaDueAt])
}

// ─── ORDER ITEM (SNAPSHOT OF EVERYTHING — FI-01) ─────────────────────────────
// status values: "ACTIVE" | "CANCELLED"

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  variantId    String? // Nullable relation if variant gets deleted
  productName  String? // Snapshot product title at placement (e.g. "Cotton Kurta Set")
  variantTitle String? // Snapshot variant title (e.g. "Red / M")
  sku          String? // Snapshot SKU (e.g. "VE-APP-KUR-RED-M")
  quantity     Int
  price        Float   // Unit price at time of order (snapshot)
  originalPrice Float? // List price if overridden in manual order
  discountAmount Float? @default(0) // Snapshot line discount
  taxableValue Float?  // Snapshot per-line taxable value
  hsnCode      String? // Snapshot HSN code at order placement time
  gstRate      Float?  // Snapshot GST % at order placement time
  cgstAmount   Float?  @default(0) // Snapshot CGST amount
  sgstAmount   Float?  @default(0) // Snapshot SGST amount
  igstAmount   Float?  @default(0) // Snapshot IGST amount
  cessAmount   Float?  @default(0) // Snapshot CESS amount
  lineTotal    Float?  // Snapshot line total after taxes and discounts
  status       String  @default("ACTIVE") // "ACTIVE" | "CANCELLED"
  cancelledQty Int     @default(0)
  createdAt    DateTime @default(now())

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id])
  variant     ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  adjustments OrderLineAdjustment[]

  @@index([orderId])
  @@index([sku])
}

// ─── ORDER LINE ADJUSTMENTS (ORD-05: CORRECTIONS WITHOUT MUTATING LINE) ──────
// adjustmentType values: "CANCELLATION" | "DISCOUNT"

model OrderLineAdjustment {
  id             String   @id @default(uuid())
  orderItemId    String
  adjustmentType String   // "CANCELLATION" | "DISCOUNT"
  quantity       Int      @default(0)
  amount         Float    // Reduction in line taxable/base amount
  taxAmount      Float    @default(0) // Reduction in tax amount
  reason         String?
  createdBy      String?  // Actor name/id
  createdAt      DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

// ─── ORDER STATUS HISTORY (ORD-09: AUDIT TIMELINE) ───────────────────────────

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String
  fromStatus String?
  toStatus   String
  reason     String?
  note       String?
  createdBy  String?  // Actor name/id or "System"
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ─── ORDER NOTES (ORD-08: INTERNAL & CUSTOMER NOTES) ────────────────────────

model OrderNote {
  id                String   @id @default(uuid())
  orderId           String
  body              String
  isCustomerVisible Boolean  @default(false)
  createdBy         String?  // Actor name/id
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ─── INVOICE (ORD-11: GAPLESS GST INVOICE) ───────────────────────────────────

model Invoice {
  id             String   @id @default(uuid())
  orderId        String   @unique
  invoiceNumber  String   @unique // e.g. "VE/26-27/0042"
  financialYear  String   // e.g. "2026-27"
  sequenceNumber Int      // Sequential gapless number within FY
  totalAmount    Float
  taxAmount      Float
  pdfUrl         String?
  invoiceData    String   // JSON snapshot of seller, buyer, line items, taxes
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([financialYear, sequenceNumber])
}

// ─── COUPON ──────────────────────────────────────────────────────────────────

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    // "PERCENTAGE" | "FLAT"
  discountValue Float     // e.g. 10 (%) or 500 (₹)
  minOrderValue Float     @default(0)
  maxDiscount   Float?    // Cap for percentage discounts (e.g. max ₹1,000)
  usageLimit    Int?      // Null = unlimited
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

// ─── REVIEW ──────────────────────────────────────────────────────────────────

model Review {
  id                 String    @id @default(uuid())
  userId             String
  productId          String
  rating             Int       // 1 to 5
  title              String?
  comment            String
  isVerifiedPurchase Boolean   @default(false)
  status             String    @default("APPROVED") // "APPROVED" | "PENDING" | "REJECTED"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actorName   String
  actorRole   String
  entity      String   // e.g. "PRODUCT", "ORDER", "COUPON", "INVENTORY"
  entityId    String
  action      String   // e.g. "UPDATE_PRICE", "ADJUST_STOCK", "CREATE_COUPON"
  beforeState String?  // JSON string snapshot
  afterState  String?  // JSON string snapshot
  ipAddress   String?
  timestamp   DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// ─── LEAD ────────────────────────────────────────────────────────────────────
// status values: "NEW" | "CONTACTED" | "QUOTED" | "CLOSED_WON" | "CLOSED_LOST"

model Lead {
  id           String    @id @default(uuid())
  name         String
  phone        String
  email        String?
  city         String?
  pincode      String?
  productId    String?
  productName  String    // Denormalised — preserved even if product is deleted
  message      String?
  status       String    @default("NEW")
  ownerNotes   String?
  followupDate DateTime?
  sourceUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  product Product? @relation(fields: [productId], references: [id])
}

// ─── WISHLIST ────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  variantId String?  // Optional variant-specific wishlisting
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
}

// ─── UNIT OF MEASURE (EPIC-02: TAX-01) ───────────────────────────────────────
// unitType values: "COUNT" | "WEIGHT" | "VOLUME" | "LENGTH" | "AREA"

model Unit {
  id               String    @id @default(uuid())
  name             String    @unique
  symbol           String    // e.g. "pcs", "kg", "m"
  unitType         String    // "COUNT" | "WEIGHT" | "VOLUME" | "LENGTH" | "AREA"
  decimalPrecision Int       @default(0) // 0 to 3
  isActive         Boolean   @default(true)
  isSystem         Boolean   @default(false) // Seeded units cannot be deleted
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  products Product[]
}

// ─── HSN CODE (EPIC-02: TAX-02, TAX-03) ──────────────────────────────────────
// rateType values: "FLAT" | "SLAB"

model HsnCode {
  id          String    @id @default(uuid())
  code        String    @unique // 4, 6, or 8 digits
  description String
  rateType    String    @default("FLAT") // "FLAT" | "SLAB"
  cessRate    Float?    @default(0) // Additional CESS rate %
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  rateVersions     HsnRateVersion[]
  categoryMappings CategoryHsnMapping[]
  products         Product[]
  defaultSettings  TaxSettings[]
}

// ─── HSN RATE VERSION (EPIC-02: TAX-07) ──────────────────────────────────────

model HsnRateVersion {
  id            String    @id @default(uuid())
  hsnId         String
  gstRate       Float?    // Flat rate % (e.g. 18.0). Null if rateType is SLAB
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdBy     String?   // User name or email
  createdAt     DateTime  @default(now())

  hsn   HsnCode        @relation(fields: [hsnId], references: [id], onDelete: Cascade)
  slabs HsnPriceSlab[]

  @@index([hsnId, effectiveFrom])
}

// ─── HSN PRICE SLAB (EPIC-02: TAX-03) ────────────────────────────────────────

model HsnPriceSlab {
  id            String @id @default(uuid())
  rateVersionId String
  minPrice      Float  // Stored in INR (e.g. 0.00, 1000.01)
  maxPrice      Float? // Null = open-ended ("No limit")
  gstRate       Float  // Rate % for this price slab

  rateVersion HsnRateVersion @relation(fields: [rateVersionId], references: [id], onDelete: Cascade)

  @@index([rateVersionId])
}

// ─── CATEGORY HSN MAPPING (EPIC-02: TAX-04) ─────────────────────────────────

model CategoryHsnMapping {
  id         String   @id @default(uuid())
  categoryId String   @unique
  hsnId      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  hsn      HsnCode  @relation(fields: [hsnId], references: [id], onDelete: Restrict)
}

// ─── TAX SETTINGS (EPIC-02: TAX-05) ─────────────────────────────────────────
// pricingMode values: "EXCLUSIVE" | "INCLUSIVE"

model TaxSettings {
  id              String   @id @default(uuid())
  sellerStateCode String   @default("27") // e.g. "27" Maharashtra
  sellerGstin     String   @default("27AABCV1234K1Z5")
  pricingMode     String   @default("EXCLUSIVE") // "EXCLUSIVE" | "INCLUSIVE"
  defaultHsnId    String?
  updatedAt       DateTime @updatedAt

  defaultHsn HsnCode? @relation(fields: [defaultHsnId], references: [id], onDelete: SetNull)
}

// ─── LOCATION (EPIC-04: INV-12 Future Multi-location Scaffold) ───────────────

model Location {
  id        String   @id @default(uuid())
  name      String   // e.g. "Main Warehouse"
  code      String   @unique // e.g. "MAIN"
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories Inventory[]
}

// ─── INVENTORY (EPIC-04: INV-01 Stock Record) ────────────────────────────────

model Inventory {
  id                String    @id @default(uuid())
  variantId         String
  locationId        String
  sellerId          String?   // House seller default (D-02)
  onHand            Int       @default(0) // Physical units in building (must be >= 0)
  reserved          Int       @default(0) // Committed to unfulfilled orders (must be >= 0)
  lowStockThreshold Int?      @default(5) // Variant threshold, null/default = 5
  backorderEnabled  Boolean   @default(false)
  lastCountedAt     DateTime?
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location  Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  @@unique([variantId, locationId])
  @@index([locationId])
  @@index([variantId])
}

// ─── INVENTORY MOVEMENT (EPIC-04: THE IMMUTABLE LEDGER) ──────────────────────
// movementType: "ADJUSTMENT" | "RESERVATION" | "RELEASE" | "FULFILMENT" | "RETURN"
// reasonCode  : "PURCHASE" | "SALE" | "RETURN" | "DAMAGE" | "THEFT" | "CORRECTION" | "TRANSFER"
// referenceType: "ORDER" | "ADJUSTMENT" | "IMPORT" | "RETURN" | "SHIPMENT"

model InventoryMovement {
  id            String   @id @default(uuid())
  inventoryId   String
  variantId     String
  movementType  String   // "ADJUSTMENT" | "RESERVATION" | "RELEASE" | "FULFILMENT" | "RETURN"
  reasonCode    String   // "PURCHASE" | "SALE" | "RETURN" | "DAMAGE" | "THEFT" | "CORRECTION" | "TRANSFER"
  quantityDelta Int      // Signed integer
  onHandAfter   Int
  reservedAfter Int
  referenceType String?  // "ORDER" | "ADJUSTMENT" | "IMPORT" | "RETURN" | "SHIPMENT"
  referenceId   String?
  note          String?
  batchId       String?
  createdBy     String?  // Actor ID or Name, or "System"
  createdAt     DateTime @default(now())

  // Append-only: strictly NO updatedAt, NO deletedAt.
  inventory Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([inventoryId, createdAt])
  @@index([batchId])
  @@index([referenceType, referenceId])
}

// ─── STOCK ALERT (EPIC-04: INV-07 Low-Stock Alerts) ──────────────────────────
// alertType: "LOW_STOCK" | "OUT_OF_STOCK"

model StockAlert {
  id                 String    @id @default(uuid())
  variantId          String
  alertType          String    // "LOW_STOCK" | "OUT_OF_STOCK"
  triggeredAt        DateTime  @default(now())
  availableAtTrigger Int
  resolvedAt         DateTime?
  notifiedAt         DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, resolvedAt])
  @@index([alertType, resolvedAt])
}


