// ─────────────────────────────────────────────────────────────────────────────
// Vaishnavi Enterprises — Prisma Schema v2.4 (SQLite Dev / PostgreSQL Production)
// Local dev  : SQLite (DATABASE_URL="file:./dev.db")
// Production : Switch provider to "postgresql" + update DATABASE_URL
//
// POSTGRESQL MIGRATION NOTES (when deploying):
//   - Change provider = "sqlite" → "postgresql"
//   - Change specs String → Json
//   - Change shippingAddress String → Json
//   - (Optional) Convert the String representation of roles, modes, and statuses
//     to native PostgreSQL Enums if desired.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── NEXTAUTH REQUIRED MODELS ────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USER ────────────────────────────────────────────────────────────────────
// Role values: "CUSTOMER" | "ADMIN"

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  emailVerified DateTime? // Required by NextAuth standard Adapter
  image         String?   // Required by NextAuth standard Adapter
  phone         String?   @unique
  passwordHash  String?
  role          String    @default("CUSTOMER") // "CUSTOMER" | "ADMIN" | "SUPER_ADMIN" | "CATALOG_MANAGER" | "OPS_EXECUTIVE" | "FINANCE"
  name          String?
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  addresses     Address[]
  orders        Order[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  accounts      Account[]
  sessions      Session[]
  carts         Cart[]
}

// ─── ADDRESS ─────────────────────────────────────────────────────────────────

model Address {
  id             String  @id @default(uuid())
  userId         String
  fullName       String
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  state          String
  pincode        String
  alternatePhone String?
  isDefault      Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── MEDIA IMAGE (Shared Library) ────────────────────────────────────────────

model MediaImage {
  id        String   @id @default(uuid())
  url       String   // Supabase Storage public URL
  filename  String   // Original filename before compression
  size      Int      // File size in bytes after compression
  width     Int?     // Pixel width after compression
  height    Int?     // Pixel height after compression
  alt       String?  // Alt text for accessibility and SEO
  createdAt DateTime @default(now())

  products   ProductImage[]
  brands     Brand[]        // Brands that use this image as their logo
  categories Category[]     // Categories that use this as banner image
}

// ─── BRAND ───────────────────────────────────────────────────────────────────

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoId      String?   // References MediaImage
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  logo     MediaImage? @relation(fields: [logoId], references: [id])
  products Product[]
}

// ─── CATEGORY ────────────────────────────────────────────────────────────────
// defaultCheckoutMode values: "BUY" | "INQUIRE"

model Category {
  id                  String    @id @default(uuid())
  name                String
  slug                String    @unique
  description         String?
  imageId             String?   // References MediaImage for category banner
  defaultCheckoutMode String    @default("BUY") // "BUY" | "INQUIRE"
  hsnCode             String?   // Default HSN code for products in this category
  gstRate             Float?    @default(18.0) // Default GST % (e.g. 18.0)
  sortOrder           Int       @default(0)
  parentId            String?   // null = top-level; populated = sub-category
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  image              MediaImage?         @relation(fields: [imageId], references: [id])
  parent             Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryHierarchy")
  products           Product[]
  categoryAttributes CategoryAttribute[]

  // No two categories may share the same name within the same parent scope
  @@unique([name, parentId])
}

// ─── PRODUCT ─────────────────────────────────────────────────────────────────
// checkoutMode values: "BUY" | "INQUIRE"
// stockMode values: "TRACKED" | "VIRTUAL" | "INQUIRE"

model Product {
  id           String    @id @default(uuid())
  title        String
  description  String
  basePrice    Float
  checkoutMode String    // "BUY" | "INQUIRE"
  stockMode    String    // "TRACKED" | "VIRTUAL" | "INQUIRE"
  isAvailable  Boolean   @default(true)
  categoryId   String
  brandId      String?
  sellerId     String?   // House seller record default, future multi-vendor (D-02)
  hsnCode      String?   // Overrides Category HSN code (D-06)
  gstRate      Float?    // Overrides Category GST % (D-06)
  specs        String    @default("{}") // SQLite: stored as JSON string
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  category        Category                @relation(fields: [categoryId], references: [id])
  brand           Brand?                  @relation(fields: [brandId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  wishlist        WishlistItem[]
  reviews         Review[]
  leads           Lead[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
}

// ─── PRODUCT IMAGE (Join Table) ───────────────────────────────────────────────

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  imageId   String
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   MediaImage @relation(fields: [imageId], references: [id])

  @@unique([productId, imageId])
}

// ─── PRODUCT VARIANT ─────────────────────────────────────────────────────────

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String
  title       String    // e.g. "1200mm Brown", "2.5mm Black 90M", "50W Cool White"
  price       Float?    // null = inherits product basePrice
  mrp         Float?    // Maximum Retail Price
  stock       Int       @default(0) // Active only when Product.stockMode = "TRACKED"
  sku         String?   @unique
  color       String?
  size        String?
  isAvailable Boolean   @default(true)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

// ─── ATTRIBUTES & VARIANTS (EPIC-01: ATTR) ──────────────────────────────────
// inputType values: "SINGLE_SELECT" | "MULTI_SELECT" | "TEXT" | "NUMBER" | "BOOLEAN"

model Attribute {
  id                String    @id @default(uuid())
  name              String
  code              String    @unique // Lowercase slug, immutable after creation
  inputType         String    @default("SINGLE_SELECT") // "SINGLE_SELECT" | "MULTI_SELECT" | "TEXT" | "NUMBER" | "BOOLEAN"
  isVariantDefining Boolean   @default(false) // true only for SINGLE_SELECT attributes that generate SKUs
  description       String?
  usesSwatches      Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  values             AttributeValue[]
  categoryAttributes CategoryAttribute[]
  productValues      ProductAttributeValue[]
  variantValues      VariantAttributeValue[]
}

model AttributeValue {
  id             String    @id @default(uuid())
  attributeId    String
  label          String
  code           String    // Lowercase slug, immutable after creation
  swatchHex      String?   // e.g. "#006A4E"
  swatchImageUrl String?   // URL for texture swatches
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  attribute              Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributeValues ProductAttributeValue[]
  variantAttributeValues VariantAttributeValue[]

  @@unique([attributeId, code])
}

model CategoryAttribute {
  id           String   @id @default(uuid())
  categoryId   String
  attributeId  String
  isRequired   Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
}

model ProductAttributeValue {
  id               String   @id @default(uuid())
  productId        String
  attributeId      String
  attributeValueId String?  // Set for SELECT / MULTI_SELECT
  textValue        String?  // Set for TEXT
  numberValue      Float?   // Set for NUMBER
  boolValue        Boolean? // Set for BOOLEAN
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id])
}

model VariantAttributeValue {
  id               String @id @default(uuid())
  variantId        String
  attributeId      String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([variantId, attributeId])
}

// ─── CART (Required for Server-Side Cart Persistence) ────────────────────────

model Cart {
  id        String     @id @default(uuid())
  userId    String?    // Nullable for guest carts
  token     String     @unique // Unique token passed in cookies for guest verification
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?  // Optional relation to specific product variant
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─── ORDER ───────────────────────────────────────────────────────────────────
// status values: "PENDING" | "CAPTURED" | "COD_CONFIRMED" | "FULFILLED" | "DELIVERED" | "CANCELLED" | "REFUNDED"

model Order {
  id                String    @id @default(uuid())
  userId            String
  status            String    @default("PENDING")
  totalAmount       Float
  discountAmount    Float     @default(0)
  couponCode        String?
  paymentMethod     String    // "RAZORPAY" | "COD"
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  shiprocketOrderId String?   @unique
  shippingCost      Float     @default(0)
  deliveryZone      String    // "LOCAL" | "UP" | "PAN_INDIA"
  trackingNumber    String?
  trackingUrl       String?
  shippingAddress   String    // SQLite: JSON string snapshot of address
  sellerId          String?   // House seller record default (D-02)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

// ─── ORDER ITEM ──────────────────────────────────────────────────────────────

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  variantId    String? // Nullable relation if variant gets deleted
  variantTitle String? // Snapshot variant title (e.g. "1200mm Brown")
  quantity     Int
  price        Float   // Price at time of order (snapshot)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─── COUPON ──────────────────────────────────────────────────────────────────

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    // "PERCENTAGE" | "FLAT"
  discountValue Float     // e.g. 10 (%) or 500 (₹)
  minOrderValue Float     @default(0)
  maxDiscount   Float?    // Cap for percentage discounts (e.g. max ₹1,000)
  usageLimit    Int?      // Null = unlimited
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

// ─── REVIEW ──────────────────────────────────────────────────────────────────

model Review {
  id                 String    @id @default(uuid())
  userId             String
  productId          String
  rating             Int       // 1 to 5
  title              String?
  comment            String
  isVerifiedPurchase Boolean   @default(false)
  status             String    @default("APPROVED") // "APPROVED" | "PENDING" | "REJECTED"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actorName   String
  actorRole   String
  entity      String   // e.g. "PRODUCT", "ORDER", "COUPON", "INVENTORY"
  entityId    String
  action      String   // e.g. "UPDATE_PRICE", "ADJUST_STOCK", "CREATE_COUPON"
  beforeState String?  // JSON string snapshot
  afterState  String?  // JSON string snapshot
  ipAddress   String?
  timestamp   DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// ─── LEAD ────────────────────────────────────────────────────────────────────
// status values: "NEW" | "CONTACTED" | "QUOTED" | "CLOSED_WON" | "CLOSED_LOST"

model Lead {
  id           String    @id @default(uuid())
  name         String
  phone        String
  email        String?
  city         String?
  pincode      String?
  productId    String?
  productName  String    // Denormalised — preserved even if product is deleted
  message      String?
  status       String    @default("NEW")
  ownerNotes   String?
  followupDate DateTime?
  sourceUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  product Product? @relation(fields: [productId], references: [id])
}

// ─── WISHLIST ────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  variantId String?  // Optional variant-specific wishlisting
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
}

