# ─────────────────────────────────────────────────────────────────────────────
# Vaishnavi Enterprises Environment Variables Example
# Copy this file to .env and populate the credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Database URL
# Local Dev (SQLite): file:./dev.db
# Production (PostgreSQL): postgresql://user:password@host:port/db?schema=public
DATABASE_URL="file:./dev.db"

# NextAuth Settings
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-secure-32-character-random-string-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay credentials (Indian Payment Gateway)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Shiprocket credentials (Logistics)
SHIPROCKET_EMAIL="placeholder@email.com"
SHIPROCKET_PASSWORD="placeholder_password"
SHIPROCKET_PICKUP_PINCODE="YOUR_PICKUP_PINCODE" # Suriyawan godown pincode is 221404

# MSG91 credentials (SMS / OTP)
MSG91_AUTH_KEY="placeholder_auth_key"
MSG91_OTP_TEMPLATE_ID="placeholder_template_id"
MSG91_ORDER_TEMPLATE_ID="placeholder_template_id"
MSG91_LEAD_TEMPLATE_ID="placeholder_template_id"

# Brevo SMTP credentials (Transactional Email)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="placeholder_smtp_user"
SMTP_PASS="placeholder_smtp_pass"
MAIL_FROM="noreply@vaishnavi-enterprises.in"
OWNER_EMAIL="owner@vaishnavi-enterprises.in"
