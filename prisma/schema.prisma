// ─────────────────────────────────────────────────────────────────────────────
// Vaishnavi Enterprises — Prisma Schema v2.4 (SQLite Dev / PostgreSQL Production)
// Local dev  : SQLite (DATABASE_URL="file:./dev.db")
// Production : Switch provider to "postgresql" + update DATABASE_URL
//
// POSTGRESQL MIGRATION NOTES (when deploying):
//   - Change provider = "sqlite" → "postgresql"
//   - Change specs String → Json
//   - Change shippingAddress String → Json
//   - (Optional) Convert the String representation of roles, modes, and statuses
//     to native PostgreSQL Enums if desired.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── NEXTAUTH REQUIRED MODELS ────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USER ────────────────────────────────────────────────────────────────────
// Role values: "CUSTOMER" | "ADMIN"

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  emailVerified DateTime? // Required by NextAuth standard Adapter
  image         String?   // Required by NextAuth standard Adapter
  phone         String?   @unique
  passwordHash  String?
  role          String    @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  name          String?
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  wishlistItems WishlistItem[]
  accounts      Account[]
  sessions      Session[]
  carts         Cart[]
}

// ─── ADDRESS ─────────────────────────────────────────────────────────────────

model Address {
  id             String  @id @default(uuid())
  userId         String
  fullName       String
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  state          String
  pincode        String
  alternatePhone String?
  isDefault      Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── MEDIA IMAGE (Shared Library) ────────────────────────────────────────────

model MediaImage {
  id        String   @id @default(uuid())
  url       String   // Supabase Storage public URL
  filename  String   // Original filename before compression
  size      Int      // File size in bytes after compression
  width     Int?     // Pixel width after compression
  height    Int?     // Pixel height after compression
  alt       String?  // Alt text for accessibility and SEO
  createdAt DateTime @default(now())

  products   ProductImage[]
  brands     Brand[]        // Brands that use this image as their logo
  categories Category[]     // Categories that use this as banner image
}

// ─── BRAND ───────────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logoId      String?  // References MediaImage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logo     MediaImage? @relation(fields: [logoId], references: [id])
  products Product[]
}

// ─── CATEGORY ────────────────────────────────────────────────────────────────
// defaultCheckoutMode values: "BUY" | "INQUIRE"

model Category {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  description         String?
  imageId             String?  // References MediaImage for category banner
  defaultCheckoutMode String   @default("BUY") // "BUY" | "INQUIRE"
  sortOrder           Int      @default(0)
  parentId            String?  // null = top-level; populated = sub-category
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  image    MediaImage? @relation(fields: [imageId], references: [id])
  parent   Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]  @relation("CategoryHierarchy")
  products Product[]

  // No two categories may share the same name within the same parent scope
  @@unique([name, parentId])
}

// ─── PRODUCT ─────────────────────────────────────────────────────────────────
// checkoutMode values: "BUY" | "INQUIRE"
// stockMode values: "TRACKED" | "VIRTUAL" | "INQUIRE"

model Product {
  id           String   @id @default(uuid())
  title        String
  description  String
  basePrice    Float
  checkoutMode String   // "BUY" | "INQUIRE"
  stockMode    String   // "TRACKED" | "VIRTUAL" | "INQUIRE"
  isAvailable  Boolean  @default(true)
  categoryId   String
  brandId      String?
  specs        String   @default("{}") // SQLite: stored as JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  brand      Brand?         @relation(fields: [brandId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  wishlist   WishlistItem[]
  leads      Lead[]
  orderItems OrderItem[]
  cartItems  CartItem[]
}

// ─── PRODUCT IMAGE (Join Table) ───────────────────────────────────────────────

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  imageId   String
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   MediaImage @relation(fields: [imageId], references: [id])

  @@unique([productId, imageId])
}

// ─── PRODUCT VARIANT ─────────────────────────────────────────────────────────

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  title       String   // e.g. "1200mm Brown", "2.5mm Black 90M", "50W Cool White"
  price       Float?   // null = inherits product basePrice
  stock       Int      @default(0) // Active only when Product.stockMode = "TRACKED"
  sku         String?  @unique
  color       String?
  size        String?
  isAvailable Boolean  @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
}

// ─── CART (Required for Server-Side Cart Persistence) ────────────────────────

model Cart {
  id        String     @id @default(uuid())
  userId    String?    // Nullable for guest carts
  token     String     @unique // Unique token passed in cookies for guest verification
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?  // Optional relation to specific product variant
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─── ORDER ───────────────────────────────────────────────────────────────────
// status values: "PENDING" | "CAPTURED" | "COD_CONFIRMED" | "FULFILLED" | "DELIVERED" | "CANCELLED" | "REFUNDED"

model Order {
  id                String   @id @default(uuid())
  userId            String
  status            String   @default("PENDING")
  totalAmount       Float
  paymentMethod     String   // "RAZORPAY" | "COD"
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  shiprocketOrderId String?  @unique
  shippingCost      Float    @default(0)
  deliveryZone      String   // "LOCAL" | "UP" | "PAN_INDIA"
  trackingNumber    String?
  trackingUrl       String?
  shippingAddress   String   // SQLite: JSON string snapshot of address
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

// ─── ORDER ITEM ──────────────────────────────────────────────────────────────

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  variantId    String? // Nullable relation if variant gets deleted
  variantTitle String? // Snapshot variant title (e.g. "1200mm Brown")
  quantity     Int
  price        Float   // Price at time of order (snapshot)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─── LEAD ────────────────────────────────────────────────────────────────────
// status values: "NEW" | "CONTACTED" | "QUOTED" | "CLOSED_WON" | "CLOSED_LOST"

model Lead {
  id           String    @id @default(uuid())
  name         String
  phone        String
  email        String?
  city         String?
  pincode      String?
  productId    String?
  productName  String    // Denormalised — preserved even if product is deleted
  message      String?
  status       String    @default("NEW")
  ownerNotes   String?
  followupDate DateTime?
  sourceUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product Product? @relation(fields: [productId], references: [id])
}

// ─── WISHLIST ────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  variantId String?  // Optional variant-specific wishlisting
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
}
